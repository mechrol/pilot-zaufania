// Pilot Zaufania — schema bazy danych
// Profile: Pasażer, Kierowca, Samochód, Trasa

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Passenger {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  dateOfBirth DateTime?
  street   String?
  city     String?
  postCode String?
  country  String?  @default("Polska")
  preferredPayment   String?
  accessibilityNeeds String?
  notes              String?
  routes Route[]
}

model Driver {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?
  dateOfBirth   DateTime?
  licenseNumber String   @unique
  licenseExpiry DateTime?
  licenseCategories String?
  street   String?
  city     String?
  postCode String?
  country  String?  @default("Polska")
  yearsOfExperience Int?
  status            String?
  rating            Float?   @default(5.0)
  notes             String?
  cars   Car[]
  routes Route[]
}

model Car {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand             String
  model             String
  year              Int?
  registrationPlate String  @unique
  vin               String? @unique
  fuelType       String?
  engineCapacity Float?
  powerKw        Float?
  seats          Int?      @default(5)
  doors          Int?      @default(5)
  color          String?
  mileage        Int?
  insuranceProvider   String?
  insuranceNumber     String?
  insuranceExpiry     DateTime?
  technicalInspection DateTime?
  isActive            Boolean   @default(true)
  driverId String
  driver   Driver  @relation(fields: [driverId], references: [id])
  routes Route[]
}

model Route {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name        String
  description String?
  startPoint  String
  endPoint    String
  startLat    Float?
  startLng    Float?
  endLat      Float?
  endLng      Float?
  distanceKm       Float?
  estimatedTimeMin Int?
  status      String   @default("zaplanowana")
  scheduledAt DateTime?
  passengerId String?
  passenger   Passenger? @relation(fields: [passengerId], references: [id])
  driverId    String?
  driver      Driver?    @relation(fields: [driverId], references: [id])
  carId       String?
  car         Car?       @relation(fields: [carId], references: [id])
  waypoints Waypoint[]
}

model Waypoint {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order       Int
  name        String
  description String?
  address   String
  latitude  Float?
  longitude Float?
  eventType     String?
  eventStatus   String?   @default("oczekujace")
  registeredAt  DateTime?
  registeredBy  String?
  estimatedArrival DateTime?
  actualArrival    DateTime?
  notes String?
  routeId String
  route   Route  @relation(fields: [routeId], references: [id])
}
